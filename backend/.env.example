# ==============================================================================
# Job Portal Backend Environment Configuration Template
# Copy this file to .env or set these environment variables in your system.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/jobportal
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# JWT Security Configuration
# Minimum 256-bit (32 bytes / 64 hex characters) cryptographic secret for HMAC-SHA256
JWT_SECRET=your_base64_or_hex_encoded_secret_minimum_32_characters_here
# Token expiration time in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
