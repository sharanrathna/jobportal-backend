# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/jobportal
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Secret Key (must be at least 256 bits / 32 characters)
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_string
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
